# Optional: Begrenze einen Synchronisationslauf. 0 bedeutet: alle verfügbaren Transaktionen laden.
MAX_TRANSACTIONS_PER_SYNC=0

# Optional: eigener Esplora-kompatibler Bitcoin-Explorer, falls Blockstream limitiert.
# BITCOIN_EXPLORER_BASE_URL=https://blockstream.info/api

# Optionale Alternativen für TzKT und CoinGecko.
# TZKT_API_BASE_URL=https://api.tzkt.io/v1
# COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3
# Kostenloser EUR-Tageskurs-Fallback für native Coins.
# BITVAVO_API_BASE_URL=https://api.bitvavo.com/v2
# Für Kurse älter als 365 Tage CoinGecko Pro verwenden:
# COINGECKO_API_BASE_URL=https://pro-api.coingecko.com/api/v3
# COINGECKO_API_KEY=
# Gedrosselte automatische Nachbearbeitung fehlender historischer Kurse.
# HISTORICAL_PRICE_RETRY_INTERVAL_MINUTES=15
# HISTORICAL_PRICE_BACKFILL_BATCH_SIZE=60

# Optional: TronGrid-Key für TRON-Transaktionen. Ohne Key gelten die öffentlichen Rate Limits.
# TRONGRID_API_KEY=
# TRONGRID_BASE_URL=https://api.trongrid.io

# Optionaler read-only Ethereum-RPC für ERC-20-Contract-Metadaten via viem.
# ETHEREUM_RPC_URL=https://cloudflare-eth.com

# Kommagetrennte TzKT-Aliase vertrauenswürdiger Staking-Payout-Konten.
# Der Standard erkennt "Stake.fish Payouts". Nur bestätigte Eingänge dieser Konten werden automatisch markiert.
XTZ_STAKING_PAYOUT_ALIASES=Stake.fish Payouts

# Bitcoin-xPub: BIP44-Adresslücke und Sicherheitsgrenze je Empfangs-/Wechselgeldzweig.
XPUB_GAP_LIMIT=20
XPUB_MAX_DERIVATIONS_PER_BRANCH=200

# Optional: abweichender Speicherort fuer die SQLite-Datenbank
# DATA_DIR=/data

# Docker: lokales HTTPS auf Port 3000 (Standard: true).
# Hinter einem bestehenden TLS-Reverse-Proxy bei Bedarf auf false setzen.
CRYPTOBUCH_HTTPS=true
# Eigene LAN-IP/DNS-Namen für das Zertifikat eintragen; Loopback ist immer enthalten.
# CRYPTOBUCH_TLS_HOSTS=192.168.1.154,cryptobuch.local

# UI-Updates: einmalig am Container konfigurieren; siehe docs/docker-updates.md.
# Öffentliches GitHub-Repository für stabile Releases (Standard wie unten).
# CRYPTOBUCH_UPDATE_REPOSITORY=404GamerNotFound/crypto-tax-tracking-tool
# CRYPTOBUCH_PORTAINER_URL=https://portainer.example.local:9443
# CRYPTOBUCH_PORTAINER_STACK_ID=12
# CRYPTOBUCH_PORTAINER_ENDPOINT_ID=1
# CRYPTOBUCH_PORTAINER_TOKEN_FILE=/run/secrets/portainer-token
# NODE_EXTRA_CA_CERTS=/run/secrets/portainer-ca.crt
